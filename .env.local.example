# Google AI Studio / Gemini
GOOGLE_GENERATIVE_AI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash
# Modelos de respaldo separados por coma
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Facebook Page (Meta Graph API)
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
PAGE_BRAND_NAME=Punto Ciego

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@puntociegonews

# Bluesky (AT Protocol) - usa una App Password
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Sitio público de artículos (opcional). Si está vacío, no se adjunta enlace en los posts.
PUBLIC_SITE_URL=
# Sube la carpeta site/ a Cloudflare Pages (antes: npm run site:login una vez)
SITE_DEPLOY_COMMAND=npm run site:deploy --silent
